# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas (or any managed 3-node replica set) — get this from your
# cluster's "Connect > Drivers" page. Must include a database name and,
# ideally, retryWrites/majority defaults as Atlas provides them out of the box.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urlshortener?retryWrites=true&w=majority
MONGO_URI=

# Managed Redis (e.g. Upstash) — use the TLS URL if provided (rediss://...)
# Example: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=

# Auth (dev-only secret — replace before any real deployment)
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=24h
